// ============================================
// Gallery Component
// ============================================

.gallery
  background: $color-bg-gray
  
  &__grid
    display: grid
    grid-template-columns: repeat(3, 1fr)
    gap: $spacing-lg
    margin-bottom: $spacing-xl
    
    +media-down($breakpoint-lg)
      grid-template-columns: repeat(2, 1fr)
    
    +media-down($breakpoint-md)
      grid-template-columns: 1fr
  
  &__item
    position: relative
    border-radius: $border-radius-lg
    overflow: hidden
    cursor: pointer
    
    &:hover
      .gallery__item-overlay
        opacity: 1
      
      .gallery__item-image img
        transform: scale(1.1)
  
  &__item-image
    position: relative
    aspect-ratio(4, 3)
    overflow: hidden
    
    img
      width: 100%
      height: 100%
      object-fit: cover
      transition: transform 0.5s ease
  
  &__item-overlay
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    background: linear-gradient(to bottom, rgba(10, 10, 10, 0.7) 0%, rgba(220, 0, 0, 0.9) 100%)
    display: flex
    align-items: center
    justify-content: center
    padding: $spacing-lg
    opacity: 0
    transition: opacity 0.4s ease
  
  &__item-content
    text-align: center
    color: $color-light
    transform: translateY(20px)
    transition: transform 0.4s ease
    
    .gallery__item:hover &
      transform: translateY(0)
  
  &__item-title
    font-size: $font-size-h4
    font-weight: $font-weight-bold
    color: $color-light
    margin-bottom: $spacing-sm
  
  &__item-desc
    font-size: $font-size-base
    color: rgba(255, 255, 255, 0.9)
    margin-bottom: $spacing-md
  
  &__item-specs
    display: flex
    flex-direction: column
    gap: $spacing-xs
    font-size: $font-size-sm
    color: rgba(255, 255, 255, 0.8)
    
    span
      &::before
        content: "• "
        color: $color-light
  
  &__slider-controls
    display: flex
    align-items: center
    justify-content: center
    gap: $spacing-lg
    margin-bottom: $spacing-xl
  
  &__slider-btn
    button-reset()
    width: 48px
    height: 48px
    display: flex
    align-items: center
    justify-content: center
    background: $color-light
    border: 2px solid $color-border
    border-radius: 50%
    color: $color-dark
    transition: $transition-base
    
    &:hover
      background: $color-primary
      border-color: $color-primary
      color: $color-light
      transform: scale(1.1)
    
    &:disabled
      opacity: 0.3
      cursor: not-allowed
      
      &:hover
        background: $color-light
        border-color: $color-border
        color: $color-dark
        transform: scale(1)
    
    svg
      width: 24px
      height: 24px
  
  &__slider-dots
    display: flex
    gap: $spacing-sm
    
    .dot
      width: 12px
      height: 12px
      border-radius: 50%
      background: $color-border
      cursor: pointer
      transition: $transition-fast
      
      &:hover
        background: $color-gray
      
      &.active
        background: $color-primary
        width: 32px
        border-radius: 6px
  
  &__cta
    text-align: center
    padding: $spacing-xl
    background: $color-light
    border-radius: $border-radius-lg
    box-shadow: $shadow
  
  &__cta-text
    font-size: $font-size-lg
    color: $color-text
    margin-bottom: $spacing-md
    font-weight: $font-weight-medium

// Animation on scroll
.gallery__item
  opacity: 0
  
  &.animated
    opacity: 1
    scale-in(0.5s)
  
  &:nth-child(2).animated
    animation-delay: 0.1s
  
  &:nth-child(3).animated
    animation-delay: 0.2s
  
  &:nth-child(4).animated
    animation-delay: 0.3s
  
  &:nth-child(5).animated
    animation-delay: 0.4s
  
  &:nth-child(6).animated
    animation-delay: 0.5s